theme_override_font_sizes/font_size = 32
text = "很久以前，先民与青龙、白虎、朱雀、玄武立下四象岁契。
四兽分守春夏秋冬，岁庭记录节令，人间因此得以耕作、归乡与送别。
二十年前，岁序第一次断裂。那一夜之后，冬天不再离开。
岁庭宣称四象背弃誓约，命拾契人逐一抹去它们的力量。
替亡者送信的砚带着一枚未发芽的春种踏上旅途。
她要收回四张面具，也要查清：究竟是谁把春天锁在了门外。"
horizontal_alignment = 1

